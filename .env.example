# Text LLM provider — used for question generation + scoring (PRD §8a).
# Default: gemini (see PRD §9).
TEXT_PROVIDER=gemini

# Voice engine provider — used for the realtime speech-to-speech relay (PRD §8b).
# Default: gemini (see PRD §9).
VOICE_PROVIDER=gemini

# Gemini API key — required when TEXT_PROVIDER=gemini (and later VOICE_PROVIDER=gemini).
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
