# Text LLM provider — used for question generation + scoring (PRD §8a).
# Default: gemini (see PRD §9).
TEXT_PROVIDER=gemini

# Voice engine provider — used for the realtime speech-to-speech relay (PRD §8b).
# Default: gemini (see PRD §9).
VOICE_PROVIDER=gemini

# Gemini API key — required when TEXT_PROVIDER=gemini (and later VOICE_PROVIDER=gemini).
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Relay port — the standalone Node WS relay process (see relay/server.ts,
# `npm run relay:dev`). PRD §11 — a separate long-lived process from the
# Next.js app, since Vercel functions can't hold raw WebSockets.
RELAY_PORT=8787

# WS URL the browser (app/voice) connects to for the relay. Must match
# RELAY_PORT above. Public (NEXT_PUBLIC_) because the browser reads it
# directly — it is just a localhost address, not a secret.
NEXT_PUBLIC_RELAY_URL=ws://localhost:8787
